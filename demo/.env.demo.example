# Copy to the repo root as .env  (cp demo/.env.demo.example .env)
# IMPORTANT: this file may contain ONLY keys the app knows. Any other key makes the app crash on start.
# The three AZURE_OPENAI_* values are mandatory for BOTH the API and the Streamlit UI, even for Plan B.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_DEPLOYMENT=<your-gpt-4o-deployment>

# Demo users (fictional). Passwords are placeholders: change them.
LINEAGE_USERS_JSON={"priya.nair@harborline.example":{"password":"change-me-owner","role":"Data Owner"},"tomasz.kowalski@harborline.example":{"password":"change-me-steward","role":"Domain Steward"},"marcus.oyelaran@harborline.example":{"password":"change-me-sme","role":"SME"},"chloe.park@harborline.example":{"password":"change-me-analyst","role":"Analyst"}}
