AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o

AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://...
EMAIL_SENDER_ADDRESS=lineage-agent@your-domain.com

AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...
ARTIFACTS_CONTAINER=lineage-artifacts

COSMOS_ENDPOINT=https://your-cosmos.documents.azure.com:443/
COSMOS_KEY=your-key
COSMOS_DATABASE=lineage-agent
COSMOS_CONTAINER=checkpoints

MAX_SME_ITERATIONS=3

# Alation
ALATION_BASE_URL=https://your-org.alationcloud.com
ALATION_API_TOKEN=your-token
ALATION_LINEAGE_PARENT_PATH=/Lineage Agent

# Collibra
COLLIBRA_BASE_URL=https://your-org.collibra.com
COLLIBRA_USERNAME=your-username
COLLIBRA_PASSWORD=your-password
COLLIBRA_LINEAGE_TYPE_ID=00000000-0000-0000-0000-000000003115
COLLIBRA_DOMAIN_ID=your-domain-uuid
